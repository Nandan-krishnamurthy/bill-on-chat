# Copy this file to .env and fill in the values.
# Only variables the code actually reads (app/config.py) are listed here.
# Never commit .env — it is in .gitignore.

# --- Database (required) -------------------------------------------------
# The app refuses to start without this (app/db/session.py).
# Must use the asyncpg driver prefix. Alembic and the LangGraph checkpointer
# strip "+asyncpg" automatically.
# Note: when running with Docker Compose, the DATABASE_URL set in
# docker-compose.yml overrides this value.
DATABASE_URL=postgresql+asyncpg://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/bill_on_chat

# Used only by docker-compose.yml, which builds the container's DATABASE_URL
# from these (pointing at host.docker.internal). Keep them the same as above.
POSTGRES_USER=YOUR_DB_USER
POSTGRES_PASSWORD=YOUR_DB_PASSWORD

# --- LLM (required) -------------------------------------------------------
# Groq is the only provider wired up (app/llm.py uses ChatGroq).
# Get a key at https://console.groq.com
GROQ_API_KEY=

# Optional. Plain Groq model id, no "groq:" prefix.
# Defaults to llama-3.3-70b-versatile if unset.
LLM_MODEL=llama-3.3-70b-versatile

# --- WhatsApp Cloud API (required only for the /webhook integration) ------
# Bearer token from the Meta app dashboard (WhatsApp > API Setup).
WHATSAPP_ACCESS_TOKEN=
# Numeric phone number ID from the API Setup page (not the phone number itself).
WHATSAPP_PHONE_NUMBER_ID=
# Any secret string you choose; enter the same value in the Meta webhook settings.
# Change it: the code's fallback default is public in this repo.
WHATSAPP_VERIFY_TOKEN=change-me
# Graph API version used in the send URL. Defaults to v21.0.
WHATSAPP_API_VERSION=v21.0
# ID of the row in the businesses table that ALL WhatsApp messages are routed to.
# Defaults to 1. The row must exist.
WHATSAPP_BUSINESS_ID=1
