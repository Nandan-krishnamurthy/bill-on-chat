APP_ENV=development
APP_NAME=Project Beta
APP_HOST=127.0.0.1
APP_PORT=8000

# Phase 1 contract defaults
DEFAULT_MODE=owner
DEFAULT_BUSINESS_ID=demo-business

# LLM provider seam (no secret values in template)
LLM_MODEL=groq:llama-3.3-70b-versatile
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=

# Database settings reserved for upcoming Week 2 work
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=project_beta

# WhatsApp Cloud API
# WHATSAPP_ACCESS_TOKEN: Bearer token from Meta app dashboard (Settings > WhatsApp > API Setup)
# WHATSAPP_PHONE_NUMBER_ID: Numeric phone number ID shown in the API Setup page (NOT the phone number itself)
# WHATSAPP_VERIFY_TOKEN: Arbitrary secret you chose when configuring the webhook in Meta dashboard
# WHATSAPP_API_VERSION: Graph API version (update when Meta deprecates old versions)
# WHATSAPP_BUSINESS_ID: Your internal business tenant ID — all WhatsApp messages are routed here
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=bill-on-chat-webhook
WHATSAPP_API_VERSION=v21.0
WHATSAPP_BUSINESS_ID=1
POSTGRES_USER=project_beta
POSTGRES_PASSWORD=

# Logging
LOG_LEVEL=INFO
